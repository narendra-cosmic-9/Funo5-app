<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outermost gradient stroke representing the glowing F bracket -->
    <path
        android:pathData="M 30,86 L 30,36 C 30,22 42,16 56,16 L 86,16"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="16"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="0.4" android:color="#7F00FF" />
                <item android:offset="0.8" android:color="#FF007F" />
                <item android:offset="1.0" android:color="#FF7F00" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner parallel glass highlight curve -->
    <path
        android:pathData="M 36,80 L 36,40 C 36,30 44,24 54,24 L 80,24"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#80FFFFFF" />

    <!-- The 5 loop component -->
    <path
        android:pathData="M 48,36 C 62,36 88,38 88,58 C 88,78 62,84 46,84 C 32,84 34,70 46,70 C 58,70 76,68 76,58 C 76,48 58,46 48,46 C 42,46 42,36 48,36 Z"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="36"
                android:endX="88"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF007F" />
                <item android:offset="0.5" android:color="#7F00FF" />
                <item android:offset="1.0" android:color="#00F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing dot highlight near the intersection loop -->
    <path
        android:pathData="M 46,70 A 3,3 0 1,1 45.99,70 Z"
        android:fillColor="#FFFFFF" />
</vector>
